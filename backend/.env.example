# Optional: set to a locally installed Ollama model. The assistant remains usable
# with deterministic, role-aware responses if Ollama is unavailable.
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
JWT_SECRET=replace-with-a-long-random-value
# Logs the full credential-free Ollama payload and response at INFO level.
LOG_LEVEL=INFO
